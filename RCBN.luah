export type Connection = {
    Disconnect: (Connection) -> ()
}

export type Signal = {
    Connect: (Signal, (...any) -> ()) -> Connection,
    Once: (Signal, (...any) -> ()) -> Connection,
    Until: (Signal, Event, (...any) -> ()) -> Connection,
}

export type Instance = {
    Name: string,
    -- Parent may still be nil at runtime. `any` deliberately permits assignment
    -- to a concrete type while keeping the dynamically typed hierarchy usable.
    Parent: any,
    -- The runtime preserves the concrete Instance type.  The generic forms let
    -- scripts narrow the result without forcing an unsafe `any` cast.
    FindChild: <T>(Instance, string) -> T?,
    WaitChild: <T>(Instance, string, number?) -> T?,
    GetChildren: <T>(Instance) -> { T },
    IsA: (Instance, string) -> boolean,
    Destroy: (Instance) -> (),
    Clone: <T>(Instance) -> T?,
}

export type Spatial = Instance & {
    Position: Vector3,
    Rotation: Quaternion,
    CFrame: CFrame,
    Size: Vector3,
    WorldPosition: Vector3, -- read only
    WorldCFrame: CFrame, -- read only
}

export type BaseCube = Spatial & {
    Color: Color4,
    Anchored: boolean,
    CanCollide: boolean,
    Velocity: Vector3, -- read only
    Touched: Signal,
    CastShadow: boolean,
    ShadowMode: "Always" | "Never" | "Normal",
    Unlit: boolean,
    UseTriplanar: boolean,
    TextureScale: number,
    Locked: boolean,
    CCDMode: "Default" | "Bullet",
}

export type Cube = BaseCube & {}

export type Sphere = BaseCube & {}

export type Cylinder = BaseCube & {}

export type TriangularPrism = BaseCube & {}

export type Model = Spatial & {}

export type Attachment = Spatial & {
    WorldPosition: Vector3,
    WorldCFrame: CFrame,
}

export type MeshCube = BaseCube & {
    MeshFile: string, -- read only
    Source: FileRef, -- write only
}

export type Decal = Instance & {
    TextureID: number,
    Face: number,
    Mode: number,
    Color: Color4,
    TexturePath: string, -- read only
    -- Source is write-only at runtime: assign a FileRef to load an image.
    Source: FileRef,
}

export type SurfaceMark = Spatial & {
    Color: Color4,
    FilterMode: "Exclude" | "Include",
    FilterInstances: { Instance },
    TexturePath: string, -- read only
    TextureID: number, -- read only
    Source: FileRef, -- write only
}

export type Sound = Spatial & {
    IsPlaying: boolean, -- read only
    Looped: boolean,
    Volume: number,
    Play: (Sound) -> (),
    Stop: (Sound) -> (),
    Reset: (Sound) -> (),
    Seek: (Sound, number) -> (),
    Speed: number,
    PreservePitch: boolean,
    TimePosition: number,
    Length: number,
    AutoPlay: boolean,
    ContentPath: string, -- read only
    SoundGroup: string, -- read only
    Source: FileRef, -- write only
}

export type Lighting = Instance & {
    Brightness: number,
    Direction: Vector3,
    Color: Color4,
}

export type LightSource = Instance & {
    Color: Color4,
    Brightness: number,
    Range: number,
}
export type PointLight = LightSource & {}
export type SpotLight = LightSource & { Angle: number }

export type Rope = Instance & {
    Attachment0: string,
    Attachment1: string,
    Cube0: BaseCube, -- write only
    Cube1: BaseCube, -- write only
    MaxDistance: number,
    Stiffness: number,
    Damping: number,
    LineWidth: number,
    Color: Color4,
}

export type Rod = Instance & {
    Attachment0: string,
    Attachment1: string,
    Cube0: BaseCube, -- write only
    Cube1: BaseCube, -- write only
    LineWidth: number,
    Color: Color4,
}

export type Weld = Instance & {
    Cube0: string | BaseCube, -- getter string; setter accepts BaseCube
    Cube1: string | BaseCube, -- getter string; setter accepts BaseCube
}

export type BallSocket = Instance & {
    Attachment0: string,
    Attachment1: string,
    Cube0: BaseCube, -- write only
    Cube1: BaseCube, -- write only
}

export type NoCollision = Instance & {
    Cube0: string | BaseCube, -- getter string; setter accepts BaseCube
    Cube1: string | BaseCube, -- getter string; setter accepts BaseCube
}

export type Motor = Instance & {
    Cube0: BaseCube, -- write only
    Cube1: BaseCube, -- write only
    Attachment0: string,
    Attachment1: string,
    DriveVelocity: number,
    MaxForce: number,
    Axis: Vector3,
}

export type AppImage = Instance & {
    IconPath: string,
}

export type PhysicalFileInstance = Instance & {
    Path: string, -- read only; YAML field is ContentPath
}

export type FileRef = PhysicalFileInstance & {}
export type FontFile = PhysicalFileInstance & {}
export type TextFile = PhysicalFileInstance & {
    Content: string,
}

export type Texture = Instance & {
    -- Source is write-only at runtime; Texture has no Luau getters.
    Source: FileRef,
}

-- These classes are not wired into Luau's dispatch table. Their C++ fields
-- therefore intentionally are not declared here.
export type PostEffect = Instance & {}
export type Highlight = Instance & {}

export type Animation = Instance & {
    Length: number,
    Speed: number,
    Looped: boolean,
    ContentPath: string,
    Source: string, -- read only
    LoadStatus: string, -- read only
    UsingBuiltInFallback: boolean, -- read only
}

export type Humanoid = Instance & {
    WalkSpeed: number,
    JumpPower: number,
    ClimbSpeed: number,
    JumpHeight: number,
    MaxHealth: number,
    RespawnTime: number,
    Health: number,
    WalkAnimation: Animation?,
    JumpAnimation: Animation?,
    EquipAnimation: Animation?,

    PlayAnimation: (Humanoid, Animation) -> (),
    PauseAnimation: (Humanoid) -> (),
    StopAnimation: (Humanoid) -> (),
    TakeDamage: (Humanoid, number) -> (),
    MoveToward: (Humanoid, Vector3) -> (),
    Jump: (Humanoid) -> (),

    Died: Signal,
    KeyframeReached: Signal
}

export type Script = Instance & {
    Enabled: boolean,
    Path: string,
    Source: string, -- read only
    Aborted: boolean, -- read only
    Restart: (Script) -> (),
}

export type LocalScript = Script & {

}

export type ModuleScript = Script & {

}

type CFrameData = {
    Position: Vector3,
    LookVector: Vector3,
    Rotation: Quaternion,
    inverse: (CFrame) -> CFrame,
}
type CFrameMetatable = {
    __mul: ((CFrame, CFrame) -> CFrame) & ((CFrame, Vector3) -> Vector3),
    __eq: (CFrame, CFrame) -> boolean,
}
export type CFrame = typeof(setmetatable({} :: CFrameData, {} :: CFrameMetatable))

type QuaternionData = {
    x: number, y: number, z: number, w: number,
    toEuler: (Quaternion) -> Vector3,
}
type QuaternionMetatable = {
    __mul: ((Quaternion, Quaternion) -> Quaternion) & ((Quaternion, Vector3) -> Vector3),
    __eq: (Quaternion, Quaternion) -> boolean,
}
export type Quaternion = typeof(setmetatable({} :: QuaternionData, {} :: QuaternionMetatable))

export type Terrain = Instance & {
    Enabled: boolean,
    DataPath: string,
    Seed: number,
    Flat: boolean,
    SetBlock: (Terrain, Vector3, Color4?, number?) -> boolean,
    RemoveBlock: (Terrain, Vector3) -> boolean,
    GetBlock: (Terrain, Vector3) -> { Shape: number, Color: Color4 }?,
    Raycast: (Terrain, Vector3, Vector3, number?) -> { Position: Vector3 }?,
    ApplyBrush: (Terrain, Vector3, number, number) -> (),
}

export type RaycastResult = {
    Distance: number,
    Position: Vector3,
    Instance: Instance?,
}

export type Workspace = Instance & {
    Gravity: Vector3,
    Wind: Vector3,
    PhysicsEnabled: boolean,
    Raycast: ((Workspace, Vector3, Vector3, Instance?) -> RaycastResult?) & ((Workspace, Vector3, Vector3, number, Instance?) -> RaycastResult?),
}

type Vector3Data = {
    x: number,
    y: number,
    z: number,
    length: (Vector3) -> number,
    normalize: (Vector3) -> Vector3,

}
type Vector3Metatable = {
    __add: (a: Vector3, b: Vector3) -> Vector3,
    __sub: (a: Vector3, b: Vector3) -> Vector3,
    __unm: (a: Vector3) -> Vector3,
    __mul: ((a: Vector3, b: Vector3) -> Vector3)
         & ((a: Vector3, b: number) -> Vector3)
         & ((a: number, b: Vector3) -> Vector3),
    __div: ((a: Vector3, b: Vector3) -> Vector3)
         & ((a: Vector3, b: number) -> Vector3),
    __eq: (Vector3, Vector3) -> boolean,
}
export type Vector3 = typeof(setmetatable({} :: Vector3Data, {} :: Vector3Metatable))

type Color4Data = {
    r: number,
    g: number,
    b: number,
    a: number,
}
type Color4Metatable = {
    __add: (Color4, Color4) -> Color4,
    __sub: (Color4, Color4) -> Color4,
    __unm: (Color4) -> Color4,
    __mul: ((Color4, Color4) -> Color4)
         & ((Color4, number) -> Color4)
         & ((number, Color4) -> Color4),
    __div: (Color4, number) -> Color4,
    __eq: (Color4, Color4) -> boolean,
}
export type Color4 = typeof(setmetatable({} :: Color4Data, {} :: Color4Metatable))

type Vector2Data = {
    x: number,
    y: number,
    X: number,
    Y: number,
}
type Vector2Metatable = {
    __add: (Vector2, Vector2) -> Vector2,
    __sub: (Vector2, Vector2) -> Vector2,
    __unm: (Vector2) -> Vector2,
    __mul: ((Vector2, Vector2) -> Vector2)
         & ((Vector2, number) -> Vector2)
         & ((number, Vector2) -> Vector2),
    __div: ((Vector2, Vector2) -> Vector2)
         & ((Vector2, number) -> Vector2),
    __eq: (Vector2, Vector2) -> boolean,
}
export type Vector2 = typeof(setmetatable({} :: Vector2Data, {} :: Vector2Metatable))

export type System = Instance & {
    Heartbeat: Signal,
    NetworkRoleChanged: Signal,
    NetworkRole: string,
    LocalPeerId: number,
    BaseResolution: Vector2, -- read only
    UseNetwork: boolean,
    ApplicationId: string, -- read only
    EnableIOAPI: boolean, -- read only
    EnableIPCAPI: boolean, -- read only
    EnableExternalFileAccess: boolean, -- read only
}

export type ChatService = Instance & {
    MessageReceived: Signal,
    SendMessage: (ChatService, string) -> (),
}

export type Event = Instance & {
    Fire: (Event, ...any) -> (),
}

export type GuiObject = Instance & {
    Size: Vector2,
    Norm: "Pixel" | "Scale",
    Active: boolean,
    Visible: boolean,
    BackgroundColor: Color4,
    ZIndex: number,
    Transparency: number,
}

export type ScreenGuiObject = GuiObject & {
    Position: Vector2,
    UseFontFile: boolean,
    Font: "Default" | "DotGothic16",
    FontFile: FontFile?,
    Hovered: Signal,
}

export type ImageLabel = ScreenGuiObject & {
    Image: string, -- read only
    Source: FileRef, -- write only
}
export type ImageButton = GuiButton & {
    Image: string, -- read only
    Source: FileRef, -- write only
}

export type GuiButton = ScreenGuiObject & {
    Activated: Signal,
}

export type SignalEvent = Instance & {
    Fired: Signal,
    Fire: (SignalEvent, ...any) -> (),
}

export type TextLabel = ScreenGuiObject & {
    Text: string,
    TextColor: Color4,
    FontSize: number, -- 0 = 既定サイズ
}

export type TextButton = GuiButton & {
    Text: string,
    TextColor: Color4,
    FontSize: number, -- 0 = 既定サイズ
}

export type WorldGuiObject = GuiObject & {}

export type SurfaceGui = WorldGuiObject & {
    Face: "Front" | "Back" | "Top" | "Bottom" | "Right" | "Left",
}

export type BillboardGui = WorldGuiObject & {
    Mode: "Parallel" | "Focus",
    SizeMode: "Screen" | "World",
    Offset: Vector3,
}

export type ProximityPrompt = BillboardGui & {
    KeyboardKeyCode: string,
    HoldDuration: number,
    MaxActivationDistance: number,
    Enabled: boolean,
    ActionText: string,
    ObjectText: string,
    Triggered: Signal,
}

export type Tool = Instance & {
    Activated: Signal,
    Equipped: boolean, -- read only
    Hand: number,
    Position: Vector3,
    Rotation: Quaternion,
}

export type User = Instance & {
    Input: UserInput?,
    Character: Model?,
    AddTool: (User, Tool, number?) -> number?,
    RemoveTool: (User, number|string) -> Tool?,
    GetTool: (User, number|string) -> Tool?,
    GetTools: (User) -> { Tool },
    GetMouseRay: (User) -> Ray?,
    ToggleControlMode: (User) -> string,
    ToggleCtrlLock: (User) -> boolean,
    SetCtrlLockEnabled: (User, boolean) -> boolean,
    ToggleCtrlLockOffset: (User) -> string,
    SetCtrlLockOffset: (User, string) -> string,
    ToggleMouseLock: (User) -> boolean,
    SetMouseLockEnabled: (User, boolean) -> boolean,
    SetMoveDirection: (User, Vector3) -> (),
    ClearMoveDirection: (User) -> (),
    Jump: (User) -> (),
    RequestWorkspaceSwitch: (User) -> (),
    RequestExit: (User) -> (),
    ConfirmExit: (User) -> (),
    CancelExit: (User) -> (),
    SelectToolSlot: (User, number) -> boolean,
    ActivateTool: (User) -> boolean,
    PeerId: number,
    CharacterSmoothing: number,
    MovementInputEnabled: boolean,
    CameraInputEnabled: boolean,
    HotkeyInputEnabled: boolean,
    ToolInputEnabled: boolean,
    ExitRequestPending: boolean,
    ControlMode: string,
    CameraCFrame: CFrame,
    CharacterAdded: Signal,
    ExitRequested: Signal
}

export type UserInput = Instance & {
    Pressed: Signal,
    Released: Signal,
    IsPressed: (UserInput, string) -> boolean,
}

export type ValueBase = Instance & {
    Changed: Signal,
}
export type IntValue = ValueBase & { Value: number }
export type BoolValue = ValueBase & { Value: boolean }
export type NumberValue = ValueBase & { Value: number }
export type Vector3Value = ValueBase & { Value: Vector3 }
export type Color4Value = ValueBase & { Value: Color4 }
export type CFrameValue = ValueBase & { Value: CFrame }
export type QuaternionValue = ValueBase & { Value: Quaternion }
export type ObjectValue = ValueBase & { Value: Instance? }

export type Skybox = Cube & {

}

export type ParticleEmitter = Instance & {
    StartColor: Color4,
    EndColor: Color4,
    StartSize: number,
    EndSize: number,
    EmitRate: number,
    MaxParticles: number,
    Lifetime: number,
    LifetimeVariance: number,
    Speed: number,
    SpeedVariance: number,
    Direction: Vector3,
    SpreadAngle: number,
    GravityScale: number,
    SpinSpeed: number,
    SpinSpeedVariance: number,
    Rotation: number,
    RotationVariance: number,
    Enabled: boolean,
    WindScale: number,
    SpawnRadius: number,
    CollisionCutoff: boolean,
    Emit: (ParticleEmitter, number?) -> (),
}

export type Weather = Instance & {
    Enabled: boolean,
    CurrentWeather: "Clear" | "Rain" | "Snow",
    CloudCover: number,
    CloudDensity: number,
    CloudHeight: number,
    WindDirection: Vector3,
    LightningEnabled: boolean,
    LightningInterval: number,
    ClearAmbientPath: string,
    RainAmbientPath: string,
    SnowAmbientPath: string,
    AmbientVolume: number,
}

export type PathfindingService = Instance & {
    AgentRadius: number,
    AgentHeight: number,
    AgentMaxClimb: number,
    AgentMaxSlope: number,
    MaxJumpDistance: number,
    MaxJumpHeight: number,
    FindPath: (PathfindingService, Workspace, Vector3, Vector3) -> { { Position: Vector3, Action: string } },
    Configure: (PathfindingService, { [string]: any }) -> (),
}

export type Canvas = Instance & {
    Face: "Front" | "Back" | "Top" | "Bottom" | "Right" | "Left",
    Width: number,
    Height: number,
    BackgroundColor: Color4,
    SetPixel: (Canvas, number, number, Color4) -> boolean,
    GetPixel: (Canvas, number, number) -> Color4?,
    Clear: (Canvas, Color4?) -> (),
    WorldToUV: (Canvas, Vector3) -> Vector2?,
}

export type Sun = Sphere & {
    Angle: number,
}
export type Moon = Sphere & {}
export type Truss = Cube & {}
export type Seat = Cube & { Steer: number, Throttle: number }
export type LiquidCube = BaseCube & { Density: number }
export type SpawnLocation = Cube & { Enabled: boolean }
export type StarterCharacter = Instance & {}
export type Folder = Instance & {}
export type Force = Instance & {
    Enabled: boolean,
    Torque: Vector3,
    MaintainVelocity: boolean,
    Value: Vector3,
    Force: Vector3,
}

export type Ray = { Origin: Vector3, Direction: Vector3 }

export type IOEntry = {
    Name: string,
    Path: string,
    IsDirectory: boolean,
    Size: number,
}

export type IO = {
    ReadText: (string) -> string,
    ReadBytes: (string) -> string,
    WriteText: (string, string) -> boolean,
    WriteBytes: (string, string) -> boolean,
    AppendText: (string, string) -> boolean,
    AppendBytes: (string, string) -> boolean,
    Exists: (string) -> boolean,
    IsFile: (string) -> boolean,
    IsDirectory: (string) -> boolean,
    List: (string) -> { IOEntry },
    CreateDirectory: (string) -> boolean,
    Copy: (string, string, boolean?) -> boolean,
    Move: (string, string, boolean?) -> boolean,
    Remove: (string) -> boolean,
    RemoveTree: (string) -> boolean,
}

export type IPC = {
    Connect: (...any) -> any,
    Send: (...any) -> any,
    Receive: (...any) -> any,
    Close: (...any) -> any,
}

export type task = {
    spawn: (fn: (...any) -> (...any), ...any) -> (),
    delay: (seconds: number, fn: (...any) -> (...any), ...any) -> (),
    wait:  (seconds: number?) -> ()
}

declare workspace: Workspace
declare script:    Script

declare task:      task

declare User:      User
declare System:    System
declare system:    System
declare ChatService: ChatService
declare IO: IO
declare IPC: IPC
declare erik: Erik
declare Vector3: {
    new: (number, number, number) -> Vector3,
    zero: Vector3,
}
declare Color4: {
    -- Component range: 0.0 to 1.0.
    new: (number, number, number, number?) -> Color4,
    -- Component range: 0 to 255.
    fromRGBA: (number, number, number, number?) -> Color4,
}
declare Vector2: {
    new: (number, number) -> Vector2,
}
declare Instance: { new: <T>(className: string) -> T }
declare require: <T>(moduleScript: ModuleScript) -> T

--- Sleep the script for seconds.
--- if seconds is nil, start in next frame. 
declare wait: (seconds: number?) -> ()
declare print: (...any) -> ()

declare function add(instance: Instance): ()
declare function assert<T>(value: T, message: string?): T
declare Quaternion: {
    new: (() -> Quaternion) & ((number, number, number, number) -> Quaternion),
    fromEuler: (Vector3) -> Quaternion,
    fromAxisAngle: (Vector3, number) -> Quaternion,
    Slerp: (Quaternion, Quaternion, number) -> Quaternion,
    LookRotation: (Vector3, Vector3?) -> Quaternion,
}
declare CFrame: {
    new: (() -> CFrame)
       & ((number, number, number) -> CFrame)
       & ((Vector3) -> CFrame)
       & ((Vector3, Quaternion) -> CFrame),
    fromAxisAngle: (Vector3, number) -> CFrame,
    lookAt: (Vector3, Vector3, Vector3?) -> CFrame,
}

