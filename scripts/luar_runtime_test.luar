import RuntimeModule

local RuntimeModule = require(script.RuntimeModule)

const expected: number = 42
const left, right = 20, 22

const function check(condition, label)
    if condition then
        print("[PASS] " .. label)
    else
        print("[FAIL] " .. label)
    end
end

check(answer == expected, "Luar import resolves an unqualified module value")
check(add(left, right) == expected, "Luar const bindings and module function execute")
check(workspace ~= nil, "declare global keeps the engine workspace binding")

class Counter is
    public is
        static function new(value: number)
            self.value = value
        end

        function get(): number
            return self.value
        end
    end
end

local counter = Counter.new(answer)
check(counter.get() == expected, "Luar OOP codegen executes on Luau 0.731")

local source = {
    left = shared,
    right = shared,
}
source.cycle = source
setmetatable(source, {
    __index = {
        fallback = true,
    },
})

local copy = table.deepcopy(source)
check(
    copy ~= source
        and copy.left == copy.right
        and copy.left ~= shared
        and copy.cycle == copy
        and getmetatable(copy) == nil,
    "table.deepcopy preserves graph topology without metatables"
)
