    ActionText: string
    ObjectText: string
    Enabled: boolean
    HoldDuration: number
    KeyboardKeyCode: number
    MaxActivationDistance: number end
declare class Canvas is Instance
    Width: number
    Height: number
    Face: any
    BackgroundColor: Color4
    function SetPixel(x: number,
    y: number,
    color: Color4): ()
    function GetPixel(x: number,
    y: number): Color4
    function Clear(color: Color4?): ()
    function WorldToUV(position: Vector3): Vector2 end
declare class ParticleEmitter is Instance
    Enabled: boolean
    EmitRate: number
    Lifetime: number
    LifetimeVariance: number
    MaxParticles: number
    Speed: number
    SpeedVariance: number
    Direction: Vector3
    SpreadAngle: number
    GravityScale: number
    StartColor: Color4
    EndColor: Color4
    StartSize: number
    EndSize: number
    Rotation: number
    RotationVariance: number
    SpinSpeed: number
    SpinSpeedVariance: number
    SpawnRadius: number
    WindScale: number
    CollisionCutoff: number
    function Emit(count: number?): () end
declare class Highlight is Instance
    Enabled: boolean
    FillColor: Color4
    OutlineColor: Color4
    OutlineThickness: number end

declare class Script is Instance
    Enabled: boolean
    Source: string
    Aborted: boolean
    ScriptExtension: any
    function Restart(): () end
declare class ModuleScript is Script end
declare class LocalScript is Script end
declare class ValueBase is Instance
    Changed: Signal end
declare class IntValue is ValueBase
    Value: number end
declare class NumberValue is ValueBase
    Value: number end
declare class BoolValue is ValueBase
    Value: boolean end
declare class StringValue is ValueBase
    Value: string end
declare class Vector3Value is ValueBase
    Value: Vector3 end
declare class Color4Value is ValueBase
    Value: Color4 end
declare class QuaternionValue is ValueBase
    Value: Quaternion end
declare class CFrameValue is ValueBase
    Value: CFrame end
declare class ObjectValue is ValueBase
    Value: Instance? end
declare class TextFile is PhysicalFileInstance
    Content: string end
declare class Program is PhysicalFileInstance
    function Start(): ()
    function Call(message: string): string
    function Send(message: string): ()
    function Receive(): string?
    function Connect(): ()
    function Disconnect(): ()
    function Close(): number end
declare class Event is Instance
    function Fire(...): () end
declare class SignalEvent is Instance
    Fired: Signal
    function Fire(...): () end
declare class UserInput is Instance
    Pressed: Signal
    Released: Signal
    function IsPressed(key: any): boolean end
declare class User is Instance
    Character: Model?
    Input: UserInput?
    CharacterAdded: Signal
    ExitRequested: Signal
    CursorType: any
    ControlMode: string
    CameraCFrame: CFrame
    PeerId: number
    CharacterSmoothing: number
    MovementInputEnabled: boolean
    CameraInputEnabled: boolean
    HotkeyInputEnabled: boolean
    ToolInputEnabled: boolean
    ExitRequestPending: boolean
    Speed: number
    ZoomSpeed: number
    CameraDistance: number
    RotationSpeed: number
    MouseRotationSpeed: number
    MouseZoomSpeed: number
    function AddTool(tool: Tool): ()
    function RemoveTool(tool: Tool): ()
    function GetTool(name: string): Tool?
    function GetTools(): { Tool }
    function GetMouseRay(): any
    function ToggleControlMode(): ()
    function ToggleCtrlLock(): ()
    function SetCtrlLockEnabled(enabled: boolean): ()
    function ToggleCtrlLockOffset(): ()
    function SetCtrlLockOffset(enabled: boolean): ()
    function ToggleMouseLock(): ()
    function SetMouseLockEnabled(enabled: boolean): ()
    function SetMoveDirection(direction: Vector3): ()
    function ClearMoveDirection(): ()
    function Jump(): ()
    function RequestWorkspaceSwitch(name: string): ()
    function RequestExit(): ()
    function ConfirmExit(): ()
    function CancelExit(): ()
    function SelectToolSlot(slot: number): ()
    function ActivateTool(): () end
declare class System is Instance
    EnableIOAPI: boolean
    EnableIPCAPI: boolean
    EnableExternalFileAccess: boolean
    AutoSpawnPlayerCharacter: boolean
    NetworkInterpolationDelay: number
    Heartbeat: Signal
    NetworkRoleChanged: Signal
    LocalPeerId: number
    NetworkRole: any end
declare class PathfindingService is Instance
    AgentHeight: number
    AgentRadius: number
    AgentMaxClimb: number
    AgentMaxSlope: number
    MaxJumpDistance: number
    MaxJumpHeight: number
    function Configure(): ()
    function FindPath(start: Vector3,
    goal: Vector3): { any } end
declare class Terrain is Instance
    function SetBlock(position: Vector3,
    material: any): ()
    function RemoveBlock(position: Vector3): ()
    function GetBlock(position: Vector3): any
    function Raycast(origin: Vector3,
    direction: Vector3): any
    function ApplyBrush(position: Vector3,
    radius: number,
    material: any): () end
declare class ChatService is Instance
    MessageReceived: Signal
    function SendMessage(text: string): () end
declare class AppImage is Instance
    IconPath: string end
declare class PostEffect is Instance
    Enabled: boolean
    Type: any
    FragmentShaderFile: string
