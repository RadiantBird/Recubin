        Speed: number
        PreservePitch: boolean
        SoundGroup: string
        IsPlaying: boolean
        TimePosition: number
        Length: number
        function Play(): ()
        function Stop(): ()
        function Reset(): ()
        function Seek(seconds: number): ()
    end
end
declare class Humanoid is Instance
    public is
        WalkSpeed: number
        JumpPower: number
        ClimbSpeed: number
        HipHeight: number
        JumpHeight: number
        MaxHealth: number
        RespawnTime: number
        Health: number
        WalkAnimation: Animation?
        JumpAnimation: Animation?
        EquipAnimation: Animation?
        Died: Signal
        KeyframeReached: Signal
        function PlayAnimation(animation: Animation): ()
        function PauseAnimation(): ()
        function StopAnimation(): ()
        function TakeDamage(amount: number): ()
