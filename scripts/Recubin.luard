type Arithmetic = Vector3 | number

declare class Signal is
    public is
        function Connect(callback: any): Connection
        function Once(callback: any): Connection
        function Until(callback: any): Connection
    end
end

declare class Connection is
    public is
        function Disconnect(): ()
    end
end

declare class Vector3 is
    public is
        x: number
        y: number
        z: number
        static zero: Vector3
        static function new(x: number,
        y: number,
        z: number): Vector3
        function length(v: Vector3): number
        function normalize(v: Vector3): Vector3
        function set(self,
        x: number,
        y: number,
        z: number): Vector3
        function operator+(a: Vector3,
        b: Vector3): Vector3
        function operator-(a: Vector3,
        b: Vector3): Vector3
        function operator*(a: Vector3,
        b: Arithmetic): Vector3
        function operator/(a: Vector3,
        b: Arithmetic): Vector3
    end
end

declare class Vector2 is
    public is
        X: number
        Y: number
        x: number
        y: number
        static function new(x: number,
        y: number): Vector2
        function set(self,
        x: number,
        y: number): Vector2
        function operator+(a: Vector2, b: Vector2): Vector2
        function operator-(a: Vector2, b: Vector2): Vector2
        function operator*(a: Vector2, b: Vector2 | number): Vector2
        function operator/(a: Vector2, b: Vector2 | number): Vector2
    end
end

declare class Color4 is
    public is
        r: number
        g: number
        b: number
        a: number
        static function new(r: number,
        g: number,
        b: number,
        a: number?): Color4
        static function fromRGBA(r: number,
        g: number,
        b: number,
        a: number?): Color4
        function operator+(a: Color4, b: Color4): Color4
        function operator-(a: Color4, b: Color4): Color4
        function operator*(a: Color4, b: Color4 | number): Color4
        function operator/(a: Color4, b: number): Color4
    end
end

declare class Quaternion is
    public is
        x: number
        y: number
        z: number
        w: number
        static function new(x: number,
        y: number,
        z: number,
        w: number): Quaternion
        static function fromEuler(degrees: Vector3): Quaternion
        static function fromAxisAngle(axis: Vector3,
        angle: number): Quaternion
        static function Slerp(a: Quaternion,
        b: Quaternion,
        t: number): Quaternion
        static function LookRotation(forward: Vector3,
        up: Vector3?): Quaternion
        function toEuler(): Vector3
        function operator*(a: Quaternion, b: Quaternion | Vector3): Quaternion | Vector3
    end
end

declare class CFrame is
    public is
        Position: Vector3
        Rotation: Quaternion
        LookVector: Vector3
        static function new(...): CFrame
        static function fromAxisAngle(axis: Vector3,
        angle: number): CFrame
        static function lookAt(position: Vector3,
        target: Vector3,
        up: Vector3?): CFrame
        static function Angles(x: number,
        y: number,
        z: number): CFrame
        function inverse(): CFrame
        function operator*(a: CFrame, b: CFrame | Vector3): CFrame | Vector3
    end
end

declare class Instance is
    public is
        Name: string
        Parent: Instance?
        function FindChild(name: string): Instance?
        function WaitChild(name: string,
        timeout: number?): Instance?
        function GetChildren(): { Instance }
        function IsA(classname: string): boolean
        function Destroy(): ()
        function Clone(): Instance?
        static function new(classname: string): Instance?
        static function pick(classname: string): Instance?
        static function throw(instance: Instance): ()
    end
end

declare class Spatial is Instance
    public is
        Position: Vector3
        Size: Vector3
        Rotation: Quaternion
        CFrame: CFrame
        WorldPosition: Vector3
        WorldCFrame: CFrame
    end
end

declare class BaseCube is Spatial
    public is
        Anchored: boolean
        CanCollide: boolean
        CanTouch: boolean
        CastShadow: boolean
        Color: Color4
        TextureScale: number
        Unlit: boolean
        UseTriplanar: boolean
        Velocity: Vector3
        Touched: Signal
        TouchEnded: Signal
        function SetKinematicTarget(target: CFrame, durationSeconds: number?): ()
    end
end

declare class Cube is BaseCube end
declare class Sphere is BaseCube end
declare class Cylinder is BaseCube end
declare class TriangularPrism is BaseCube end
declare class Wedge is BaseCube end
declare class LiquidCube is BaseCube
    public is
        Density: number
    end
end

declare class SpawnLocation is Cube
    public is
        Enabled: boolean
    end
end

declare class Model is Spatial
    public is
        PrimaryCube: BaseCube?
        function PivotTo(cframe: CFrame): ()
        function MoveOrigin(cframe: CFrame): ()
    end
end

declare class Workspace is Instance
    public is
        Gravity: Vector3
        Wind: Vector3
        PhysicsEnabled: boolean
        PhysicsSubsteps: number
        function Raycast(origin: Vector3,
        direction: Vector3,
        exclude: Instance | { Instance }?): any
    end
end

declare class PhysicsConstraint is Instance
    public is
        Enabled: boolean
    end
end
declare class Force is PhysicsConstraint
    public is
        Force: Vector3
        AxisMask: Vector3
        RelativeTo: any
        MaintainVelocity: boolean
    end
end
declare class Rope is PhysicsConstraint
    public is
        Cube0: BaseCube?
        Cube1: BaseCube?
        Color: Color4
        LineWidth: number
        Damping: number
        MaxDistance: number
        Stiffness: number
    end
end
declare class Rod is PhysicsConstraint
    public is
        Cube0: BaseCube?
        Cube1: BaseCube?
        Color: Color4
        LineWidth: number
    end
end
declare class Spring is PhysicsConstraint
    public is
        Cube0: BaseCube?
        Cube1: BaseCube?
        Color: Color4
        Coils: number
        Radius: number
        Thickness: number
        Visible: boolean
        Damping: number
        FreeLength: number
        Stiffness: number
    end
end
declare class Weld is PhysicsConstraint
    public is
        Cube0: BaseCube?
        Cube1: BaseCube?
    end
end
declare class Motor is PhysicsConstraint
    public is
        Cube0: BaseCube?
        Cube1: BaseCube?
        DriveVelocity: number
        MaxForce: number
        Servo: boolean
        TargetAngle: number
    end
end
declare class Motor6D is Motor end
declare class Gyro is PhysicsConstraint end
declare class BallSocket is PhysicsConstraint end
declare class NoCollision is PhysicsConstraint end
declare class PrismaticConstraint is PhysicsConstraint
    public is
        LimitsEnabled: boolean
        LowerLimit: number
        UpperLimit: number
    end
end

declare class PhysicalFileInstance is Instance
    public is
        ContentPath: string
    end
end
declare class FileRef is PhysicalFileInstance end
