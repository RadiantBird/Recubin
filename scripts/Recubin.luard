    public is
        function Start(): ()
        function Call(message: string): string
        function Send(message: string): ()
        function Receive(): string?
        function Connect(): ()
        function Disconnect(): ()
        function Close(): number
    end
end
declare class Event is Instance
    public is
        function Fire(...): ()
    end
end
declare class SignalEvent is Instance
    public is
        Fired: Signal
        function Fire(...): ()
    end
end
declare class UserInput is Instance
    public is
        Pressed: Signal
        Released: Signal
        function IsPressed(key: any): boolean
    end
end
declare class User is Instance
    public is
