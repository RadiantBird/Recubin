type Arithmetic = Vector3 | number

declare class Signal is
    function Connect(callback: any): Connection
    function Once(callback: any): Connection
    function Until(callback: any): Connection
end

declare class Connection is
    function Disconnect(): () end

declare class Vector3 is
    x: number
    y: number
    z: number
    static zero: Vector3
    static function new(x: number,
    y: number,
    z: number): Vector3
    function length(v: Vector3): number
    function normalize(v: Vector3): Vector3
    function set(self,
    x: number,
    y: number,
    z: number): Vector3
    function operator+(a: Vector3,
    b: Vector3): Vector3
    function operator-(a: Vector3,
    b: Vector3): Vector3
    function operator*(a: Vector3,
    b: Arithmetic): Vector3
    function operator/(a: Vector3,
    b: Arithmetic): Vector3
end

declare class Vector2 is
    X: number
    Y: number
    x: number
    y: number
    static function new(x: number,
    y: number): Vector2
    function set(self,
    x: number,
    y: number): Vector2
    function operator+(a: Vector2, b: Vector2): Vector2
    function operator-(a: Vector2, b: Vector2): Vector2
    function operator*(a: Vector2, b: Vector2 | number): Vector2
    function operator/(a: Vector2, b: Vector2 | number): Vector2
end

declare class Color4 is
    r: number
    g: number
    b: number
    a: number
    static function new(r: number,
    g: number,
    b: number,
    a: number?): Color4
    static function fromRGBA(r: number,
    g: number,
    b: number,
    a: number?): Color4
    function operator+(a: Color4, b: Color4): Color4
    function operator-(a: Color4, b: Color4): Color4
    function operator*(a: Color4, b: Color4 | number): Color4
    function operator/(a: Color4, b: number): Color4
end

declare class Quaternion is
    x: number
    y: number
    z: number
    w: number
    static function new(x: number,
    y: number,
    z: number,
    w: number): Quaternion
    static function fromEuler(degrees: Vector3): Quaternion
    static function fromAxisAngle(axis: Vector3,
    angle: number): Quaternion
    static function Slerp(a: Quaternion,
    b: Quaternion,
    t: number): Quaternion
    static function LookRotation(forward: Vector3,
    up: Vector3?): Quaternion
    function toEuler(): Vector3
    function operator*(a: Quaternion, b: Quaternion | Vector3): Quaternion | Vector3
end

declare class CFrame is
    Position: Vector3
    Rotation: Quaternion
    LookVector: Vector3
    static function new(...): CFrame
    static function fromAxisAngle(axis: Vector3,
    angle: number): CFrame
    static function lookAt(position: Vector3,
    target: Vector3,
    up: Vector3?): CFrame
    static function Angles(x: number,
    y: number,
    z: number): CFrame
    function inverse(): CFrame
    function operator*(a: CFrame, b: CFrame | Vector3): CFrame | Vector3
end

declare class Instance is
    Name: string
    Parent: Instance?
    function FindChild(name: string): Instance?
    function WaitChild(name: string,
    timeout: number?): Instance?
    function GetChildren(): { Instance }
    function IsA(classname: string): boolean
    function Destroy(): ()
    function Clone(): Instance?
    static function new(classname: string): Instance?
    static function pick(classname: string): Instance?
    static function throw(instance: Instance): ()
end

declare class Spatial is Instance
    Position: Vector3
    Size: Vector3
    Rotation: Quaternion
    CFrame: CFrame
    WorldPosition: Vector3
    WorldCFrame: CFrame 
end

declare class BaseCube is Spatial
    Anchored: boolean
    CanCollide: boolean
    CanTouch: boolean
    CastShadow: boolean
    Color: Color4
    TextureScale: number
    Unlit: boolean
    UseTriplanar: boolean
    Velocity: Vector3
    Touched: Signal
    TouchEnded: Signal
end

declare class Cube is BaseCube end
declare class Sphere is BaseCube end
declare class Cylinder is BaseCube end
declare class TriangularPrism is BaseCube end
declare class Wedge is BaseCube end
declare class LiquidCube is BaseCube
    Density: number 
end

declare class SpawnLocation is Cube
    Enabled: boolean 
end

declare class Model is Spatial
    PrimaryCube: BaseCube?
    function PivotTo(cframe: CFrame): ()
    function MoveOrigin(cframe: CFrame): () 
end

declare class Workspace is Instance
    Gravity: Vector3
    Wind: Vector3
    PhysicsEnabled: boolean
    PhysicsSubsteps: number
    function Raycast(origin: Vector3,
    direction: Vector3,
    exclude: Instance | { Instance }?): any
end

declare class PhysicsConstraint is Instance
    Enabled: boolean end
declare class Force is PhysicsConstraint
    Force: Vector3
    AxisMask: Vector3
    RelativeTo: any
    MaintainVelocity: boolean end
declare class Rope is PhysicsConstraint
    Cube0: BaseCube?
    Cube1: BaseCube?
    Color: Color4
    LineWidth: number
    Damping: number
    MaxDistance: number
    Stiffness: number end
declare class Rod is PhysicsConstraint
    Cube0: BaseCube?
    Cube1: BaseCube?
    Color: Color4
    LineWidth: number end
declare class Spring is PhysicsConstraint
    Cube0: BaseCube?
    Cube1: BaseCube?
    Color: Color4
    Coils: number
    Radius: number
    Thickness: number
    Visible: boolean
    Damping: number
    FreeLength: number
    Stiffness: number end
declare class Weld is PhysicsConstraint
    Cube0: BaseCube?
    Cube1: BaseCube? end
declare class Motor is PhysicsConstraint
    Cube0: BaseCube?
    Cube1: BaseCube?
    DriveVelocity: number
    MaxForce: number
    Servo: boolean
    TargetAngle: number end
declare class Motor6D is Motor end
declare class Gyro is PhysicsConstraint end
declare class BallSocket is PhysicsConstraint end
declare class NoCollision is PhysicsConstraint end
declare class PrismaticConstraint is PhysicsConstraint
    LimitsEnabled: boolean
    LowerLimit: number
    UpperLimit: number end

declare class PhysicalFileInstance is Instance
    ContentPath: string end
declare class FileRef is PhysicalFileInstance end
declare class Decal is Instance
    TextureID: number
    TexturePath: string
    Color: Color4
    Face: any
    Source: FileRef? end
declare class Texture is Instance
    Color: Color4
    Face: any
    StudsPerTileU: number
    StudsPerTileV: number
    Source: FileRef? end
declare class SurfaceMark is Spatial
    TextureID: number
    Color: Color4
    FilterMode: any
    FilterInstances: { Instance }
    Source: FileRef? end
declare class Material is Instance
    Metallic: number
    Roughness: number
    Reflectance: number
    Conductive: boolean
    DynamicFriction: number
    Restitution: number
    MassDensity: number
    TextureScale: number
    NormalStrength: number
    BaseColorMap: FileRef?
    RoughnessMap: FileRef?
    MetallicMap: FileRef?
    NormalMap: FileRef? end
declare class Lighting is Instance
    Brightness: number
    Color: Color4
    ShadowDistance: number
    ShadowFadeDistance: number end
declare class CelestialBody is Instance
    Color: Color4
    Distance: number
    GlowIntensity: number
    GlowRadius: number
    HorizonFade: boolean
    SpikeCount: number
    SpikeIntensity: number
    SpikeLength: number
    SpikeRotation: number
    VeilFalloff: number
    VeilIntensity: number end
declare class Sun is CelestialBody
    Angle: Vector2 end
declare class Moon is CelestialBody
    Phase: number
    PhaseRotation: number
    Earthshine: number end
declare class Weather is Instance
    Enabled: boolean
    CloudColor: Color4
    CloudCover: number
    CloudDensity: number
    CloudHeight: number
    WindDirection: Vector3
    CurrentWeather: any
    AmbientVolume: number
    ClearAmbientPath: string
    RainAmbientPath: string
    SnowAmbientPath: string
    LightningEnabled: boolean
    LightningInterval: number end
declare class Sound is Spatial
    Source: FileRef?
    AutoPlay: boolean
    Looped: boolean
    Volume: number
    Speed: number
    PreservePitch: boolean
    SoundGroup: string
    IsPlaying: boolean
    TimePosition: number
    Length: number
    function Play(): ()
    function Stop(): ()
    function Reset(): ()
    function Seek(seconds: number): () end
declare class Humanoid is Instance
    WalkSpeed: number
    JumpPower: number
    ClimbSpeed: number
    HipHeight: number
    JumpHeight: number
    MaxHealth: number
    RespawnTime: number
    Health: number
    WalkAnimation: Animation?
    JumpAnimation: Animation?
    EquipAnimation: Animation?
    Died: Signal
    KeyframeReached: Signal
    function PlayAnimation(animation: Animation): ()
    function PauseAnimation(): ()
    function StopAnimation(): ()
    function TakeDamage(amount: number): ()
    function MoveToward(direction: Vector3): ()
    function Jump(): () end
declare class Animation is Instance
    ContentPath: string
    Length: number
    Looped: boolean
    Speed: number
    Source: string
    LoadStatus: string
    UsingBuiltInFallback: boolean end
declare class Seat is Cube
    Steer: number
    Throttle: number
    function sit(humanoid: Humanoid): () end
declare class Tool is Model
    Hand: any
    GripC0: CFrame
    GripC1: CFrame
    Equipped: boolean
    Activated: Signal end

declare class GuiObject is Instance
    Position: Vector2
    Norm: any
    Transparency: number end
declare class ScreenGuiObject is GuiObject
    Font: any
    FontSize: number
    FontFile: FileRef?
    UseFontFile: boolean
    Locked: boolean end
declare class GuiButton is ScreenGuiObject
    Activated: Signal
    HoverEnded: Signal end
declare class TextLabel is ScreenGuiObject
    Text: string
    TextColor: Color4
    TextXAlignment: any
    TextYAlignment: any
    TextScaled: boolean end
declare class TextButton is GuiButton
    Text: string
    TextColor: Color4
    TextXAlignment: any
    TextYAlignment: any
    TextScaled: boolean end
declare class ImageLabel is ScreenGuiObject
    Image: string
    Source: FileRef? end
