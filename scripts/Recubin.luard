    Brightness: number
    Color: Color4
    Range: number end
declare class PointLight is LightSource end
declare class SpotLight is LightSource
    Angle: number end
declare class Skybox is Cube end
declare class Truss is Cube end
declare class MaterialService is Instance end

declare global
    workspace: Workspace
declare global
    script: Script
declare global
    function add(classname: string): Instance?
declare global
    function wait(seconds: number?): number
declare global
    function require(module: ModuleScript): any
declare global
    function print(...): ()
declare global
    function assert(value: any,
    message: string?): any
declare global
    function tostring(value: any): string
type IOEntry = { Name: string, Path: string, IsDirectory: boolean, Size: number }
declare global
    IO: {
    ReadText: (string) -> string,
    ReadBytes: (string) -> string,
    WriteText: (string, string) -> boolean,
    WriteBytes: (string, string) -> boolean,
    AppendText: (string, string) -> boolean,
    AppendBytes: (string, string) -> boolean,
    Exists: (string) -> boolean,
    IsFile: (string) -> boolean,
    IsDirectory: (string) -> boolean,
    List: (string) -> { IOEntry },
    CreateDirectory: (string) -> boolean,
    Copy: (string, string, boolean?) -> boolean,
    Move: (string, string, boolean?) -> boolean,
    Remove: (string) -> boolean,
    RemoveTree: (string) -> boolean }
declare global
    IPC: {
    Connect: any,
    Send: any,
    Receive: any,
    Close: any }
declare global
    task: {
    spawn: any,
    delay: any,
    wait: any }
declare global
    Enum: any