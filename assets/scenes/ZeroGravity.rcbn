recubin:
  type: scene
  version: 0
Root:
  Properties:
    BaseResolution: [1920, 1080]
    UseNetwork: false
    EnableIOAPI: false
    EnableIPCAPI: false
    EnableExternalFileAccess: false
    AutoSpawnPlayerCharacter: true
    MaxClonesPerFrame: 1000
    MaxRestartsPerFrame: 100
    MaxTasksPerFrame: 1000
    ScriptLoopTimeoutSeconds: 2
    DefaultCameraMode: Free
  Children:
    - ClassName: MaterialService
      Name: MaterialService
      Children:
        - ClassName: Material
          Name: RoughPlastic
          Properties:
            Metallic: 0
            Roughness: 1
            Reflectance: 0.5
            BaseColorMap: BaseColor
            RoughnessMap: Roughness
            MetallicMap: ""
            NormalMap: Normal
            TextureScale: 2
            NormalStrength: 0.6
            StaticFriction: 0.5
            DynamicFriction: 0.5
            Restitution: 0.1
            MassDensity: 1
            Conductive: false
          Children:
            - ClassName: FileRef
              Name: BaseColor
              Properties:
                ContentPath: assets/materials/rough_plastic_basecolor.png
            - ClassName: FileRef
              Name: Roughness
              Properties:
                ContentPath: assets/materials/rough_plastic_roughness.png
            - ClassName: FileRef
              Name: Normal
              Properties:
                ContentPath: assets/materials/rough_plastic_normal.png
        - ClassName: Material
          Name: WoodPlanks
          Properties:
            Metallic: 0
            Roughness: 1
            Reflectance: 0.3
            BaseColorMap: BaseColor
            RoughnessMap: Roughness
            MetallicMap: ""
            NormalMap: Normal
            TextureScale: 5
            NormalStrength: 1
            StaticFriction: 0.5
            DynamicFriction: 0.6
            Restitution: 0.05
            MassDensity: 0.7
            Conductive: false
          Children:
            - ClassName: FileRef
              Name: BaseColor
              Properties:
                ContentPath: assets/materials/wood_planks_basecolor.png
            - ClassName: FileRef
              Name: Roughness
              Properties:
                ContentPath: assets/materials/wood_planks_roughness.png
            - ClassName: FileRef
              Name: Normal
              Properties:
                ContentPath: assets/materials/wood_planks_normal.png
        - ClassName: Material
          Name: ScratchedMetal
          Properties:
            Metallic: 1
            Roughness: 1
            Reflectance: 0.5
            BaseColorMap: BaseColor
            RoughnessMap: Roughness
            MetallicMap: Metallic
            NormalMap: Normal
            TextureScale: 3
            NormalStrength: 1
            StaticFriction: 0.5
            DynamicFriction: 0.4
            Restitution: 0.2
            MassDensity: 3
            Conductive: true
          Children:
            - ClassName: FileRef
              Name: BaseColor
              Properties:
                ContentPath: assets/materials/scratched_metal_basecolor.png
            - ClassName: FileRef
              Name: Roughness
              Properties:
                ContentPath: assets/materials/scratched_metal_roughness.png
            - ClassName: FileRef
              Name: Metallic
              Properties:
                ContentPath: assets/materials/scratched_metal_metallic.png
            - ClassName: FileRef
              Name: Normal
              Properties:
                ContentPath: assets/materials/scratched_metal_normal.png
    - ClassName: Users
      Name: Users
      Children:
        - ClassName: User
          Name: User
          Properties:
            ControlMode: Free
            Speed: 0.25
            RotationSpeed: 1
            MouseRotationSpeed: 0.15
            CharacterSmoothing: 0.15
            CameraDistance: 10
            ZoomSpeed: 0.1
            MouseZoomSpeed: 1
            MovementInputEnabled: true
            CameraInputEnabled: true
            HotkeyInputEnabled: true
            ToolInputEnabled: true
            CursorType: Default
            CursorImages:
              - Type: Type1
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type2
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type3
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type4
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type5
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type6
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type7
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type8
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type9
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type10
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
          Children:
            - ClassName: Folder
              Name: Inventory
    - ClassName: Workspace
      Name: Workspace
      Properties:
        Gravity: [0, -196.2, 0]
        Wind: [0, 0, 0]
        PhysicsEnabled: true
      Children:
        - ClassName: Lighting
          Name: Lighting
          Properties:
            Brightness: 1
            Color: [1, 1, 1, 1]
            ShadowDistance: 160
            ShadowFadeDistance: 20
        - ClassName: Sun
          Name: Sun
          Properties:
            Angle: [135, 45]
            Color: [1, 0.95, 0.8, 1]
            Distance: 1000
            GlowIntensity: 1
            GlowRadius: 6
            VeilIntensity: 0
            VeilFalloff: 6
            SpikeIntensity: 0.1
            SpikeCount: 6
            SpikeLength: 3
            SpikeRotation: 0
