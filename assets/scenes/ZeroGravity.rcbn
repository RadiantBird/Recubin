recubin:
  type: scene
  version: 0
Root:
  Properties:
    BaseResolution: [1920, 1080]
    UseNetwork: false
    ApplicationId: 4255e1a5-7286-46fd-bef7-ab7d21cff10a
    EnableIOAPI: false
    EnableIPCAPI: false
    EnableExternalFileAccess: false
    AutoSpawnPlayerCharacter: true
    MaxClonesPerFrame: 1000
    MaxRestartsPerFrame: 100
    MaxTasksPerFrame: 1000
    ScriptLoopTimeoutSeconds: 2
    DefaultCameraMode: Character
  Children:
    - ClassName: Users
      Name: Users
      Children:
        - ClassName: User
          Name: User
          Properties:
            ControlMode: Free
            Speed: 0.25
            RotationSpeed: 1
            MouseRotationSpeed: 0.15
            CharacterSmoothing: 0.15
            CameraDistance: 10
            ZoomSpeed: 0.1
            MouseZoomSpeed: 1
            MovementInputEnabled: true
            CameraInputEnabled: true
            HotkeyInputEnabled: true
            ToolInputEnabled: true
            CursorType: Default
            CursorImages:
              - Type: Type1
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type2
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type3
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type4
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type5
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type6
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type7
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type8
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type9
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
              - Type: Type10
                ContentPath: ""
                Hotspot: [0, 0]
                Size: 32
          Children:
            - ClassName: Folder
              Name: Inventory
    - ClassName: Workspace
      Name: Workspace
      Properties:
        Gravity: [0, -196.2, 0]
        Wind: [0, 0, 0]
        PhysicsEnabled: true
      Children:
        - ClassName: Lighting
          Name: Lighting
          Properties:
            Direction: [1, -1, -1]
            Brightness: 1
            Color: [1, 1, 1, 1]
            ShadowDistance: 160
            ShadowFadeDistance: 20
        - ClassName: Cube
          Name: Cube
          Properties:
            Position: [0, 0, 0]
            Size: [100, 1, 100]
            Rotation: [0, 0, 0, 1]
            Color: [0.14230412, 0.3154574, 0.18927944, 1]
            CastShadow: true
            ShadowMode: Normal
            Unlit: false
            UseTriplanar: false
            TextureScale: 1
            Anchored: true
            CanCollide: true
            CanTouch: true
            MassDensity: 1
            CCDMode: Default
            MaterialType: 0
            StaticFriction: 0.5
            DynamicFriction: 0.5
            Restitution: 0.1
            Locked: false
            LockFlags: []
        - ClassName: Cube
          Name: Cube2
          Properties:
            Position: [1.4545593, 3, 7.8056316]
            Size: [1, 5, 3]
            Rotation: [0, 0, 0, 1]
            Color: [1, 1, 1, 1]
            CastShadow: true
            ShadowMode: Normal
            Unlit: false
            UseTriplanar: false
            TextureScale: 1
            Anchored: true
            CanCollide: true
            CanTouch: true
            MassDensity: 1
            CCDMode: Default
            MaterialType: 0
            StaticFriction: 0.5
            DynamicFriction: 0.5
            Restitution: 0.1
            Locked: false
            LockFlags: []
        - ClassName: Cube
          Name: Rotate
          Properties:
            Position: [-0.26052108, 4.18791, 5.149898]
            Size: [4, 1, 1]
            Rotation: [0, 0, 0, 1]
            Color: [1, 1, 1, 1]
            CastShadow: true
            ShadowMode: Normal
            Unlit: false
            UseTriplanar: false
            TextureScale: 1
            Anchored: false
            CanCollide: true
            CanTouch: true
            MassDensity: 1
            CCDMode: Default
            MaterialType: 0
            StaticFriction: 0.5
            DynamicFriction: 0.5
            Restitution: 0.1
            Locked: false
            LockFlags: []
          Children:
            - ClassName: Force
              Name: Force
              Properties:
                Enabled: true
                Torque: true
                MaintainVelocity: true
                Value: [0, 1, 0]
                AxisMask: [1, 1, 1]
            - ClassName: Force
              Name: Force1
              Properties:
                Enabled: true
                Torque: true
                MaintainVelocity: false
                Value: [0, 10000, 0]
                AxisMask: [1, 1, 1]
        - ClassName: Cube
          Name: Move
          Properties:
            Position: [-4.544702, 4.4721537, 6.719738]
            Size: [1, 1, 1]
            Rotation: [0, 0, 0, 1]
            Color: [1, 1, 1, 1]
            CastShadow: true
            ShadowMode: Normal
            Unlit: false
            UseTriplanar: false
            TextureScale: 1
            Anchored: false
            CanCollide: true
            CanTouch: true
            MassDensity: 1
            CCDMode: Default
            MaterialType: 0
            StaticFriction: 0.5
            DynamicFriction: 0.5
            Restitution: 0.1
            Locked: false
            LockFlags: []
          Children:
            - ClassName: Force
              Name: Force
              Properties:
                Enabled: true
                Torque: false
                MaintainVelocity: true
                Value: [0, 0, 1]
                AxisMask: [0, 0, 1]
            - ClassName: Force
              Name: Force1
              Properties:
                Enabled: true
                Torque: false
                MaintainVelocity: false
                Value: [0, 0, -1000]
                AxisMask: [0, 0, 1]
    - ClassName: PathfindingService
      Name: PathfindingService
      Properties:
        AgentRadius: 1
        AgentHeight: 5
        AgentMaxClimb: 0.6
        AgentMaxSlope: 50
        MaxJumpDistance: 6
        MaxJumpHeight: 4