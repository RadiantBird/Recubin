#!/usr/bin/env python3
import argparse
import copy
import math
import os
import sys
import tempfile
from pathlib import Path

import yaml


TOPOLOGY = [
    ("RootJoint", "Root", "Torso"),
    ("Neck", "Torso", "Head"),
    ("LeftShoulder", "Torso", "LeftArm"),
    ("RightShoulder", "Torso", "RightArm"),
    ("LeftHip", "Torso", "LeftLeg"),
    ("RightHip", "Torso", "RightLeg"),
]

PARTS = {part for _, a, b in TOPOLOGY for part in (a, b)}
JOINT_NAMES = {name for name, _, _ in TOPOLOGY}
SUPPORTED_SUFFIXES = {".yaml", ".yml", ".rcbn"}


def require_mapping(value, description):
    if not isinstance(value, dict):
        raise ValueError(f"{description} must be a mapping")
    return value


def instance_name(node):
    name = node.get("Name")
    if not isinstance(name, str) or not name:
        raise ValueError(
            f'{node.get("ClassName", "Instance")} has an empty or invalid Name'
        )
    return name


def properties(node):
    value = node.setdefault("Properties", {})
    return require_mapping(value, f'Properties of "{node.get("Name", "?")}"')


def quaternion_normalize(q, description):
    if not isinstance(q, list) or len(q) != 4:
        raise ValueError(f"invalid quaternion for {description}")

    values = [float(x) for x in q]
    if not all(math.isfinite(x) for x in values):
        raise ValueError(f"non-finite quaternion for {description}")

    length = math.sqrt(sum(x * x for x in values))
    if length < 1e-6:
        raise ValueError(f"zero-length quaternion for {description}")

    return [x / length for x in values]


def frame(node):
    p = properties(node)

    # Current Recubin scenes normally store Position/Rotation separately.
    # Accept a CFrame mapping too so the migration is not tied to only one
    # serialization spelling.
    cframe = p.get("CFrame")
    if isinstance(cframe, dict):
        pos = cframe.get("Position")
        rot = cframe.get("Rotation")
    else:
        pos = p.get("Position")
        rot = p.get("Rotation")

    name = node.get("Name", "?")

    if not isinstance(pos, list) or len(pos) != 3:
        raise ValueError(f"invalid position for {name}")

    position = [float(x) for x in pos]
    if not all(math.isfinite(x) for x in position):
        raise ValueError(f"non-finite position for {name}")

    rotation = quaternion_normalize(rot, name)
    return position, rotation


def qmul(a, b):
    ax, ay, az, aw = a
    bx, by, bz, bw = b

    return [
        aw * bx + ax * bw + ay * bz - az * by,
        aw * by - ax * bz + ay * bw + az * bx,
        aw * bz + ax * by - ay * bx + az * bw,
        aw * bw - ax * bx - ay * by - az * bz,
    ]


def qrot(q, v):
    inverse = [-q[0], -q[1], -q[2], q[3]]
    return qmul(qmul(q, [v[0], v[1], v[2], 0.0]), inverse)[:3]


def relative(a, b):
    ap, aq = a
    bp, bq = b

    inverse = [-aq[0], -aq[1], -aq[2], aq[3]]
    relative_position = qrot(
        inverse,
        [bp[i] - ap[i] for i in range(3)],
    )
    relative_rotation = quaternion_normalize(
        qmul(inverse, bq),
        "relative frame",
    )

    return {
        "Position": relative_position,
        "Rotation": relative_rotation,
    }


def identity_cframe():
    return {
        "Position": [0.0, 0.0, 0.0],
        "Rotation": [0.0, 0.0, 0.0, 1.0],
    }


def join_ref(path_parts):
    if not path_parts:
        raise ValueError("cannot create an empty instance reference")

    for part in path_parts:
        if not isinstance(part, str) or not part:
            raise ValueError("instance reference contains an invalid path component")
        if "\\" in part or "/" in part:
            raise ValueError(
                f'instance Name "{part}" contains a path separator and cannot be referenced safely'
            )

    return "\\".join(path_parts)


def reference_leaf(reference):
    if not isinstance(reference, str) or not reference:
        return None

    normalized = reference.replace("/", "\\")
    parts = [part for part in normalized.split("\\") if part]
    return parts[-1] if parts else None


def find_starter_characters(root):
    """
    Return (StarterCharacter node, workspace-relative path-to-StarterCharacter).

    Reference paths in Recubin are based on Instance.Name, not ClassName.
    Entering a Workspace resets the reference path, so:

        System -> Workspace -> Model(ClassName=StarterCharacter) -> Root

    becomes:

        Model\\Root

    and never:

        StarterCharacter\\Root
    """
    result = []

    def visit(node, workspace_path):
        if not isinstance(node, dict):
            return

        class_name = node.get("ClassName")
        current_path = workspace_path

        if class_name == "Workspace":
            current_path = []
        elif workspace_path is not None:
            current_path = [*workspace_path, instance_name(node)]

        if class_name == "StarterCharacter":
            if current_path is None:
                raise ValueError(
                    f'StarterCharacter "{node.get("Name", "?")}" is not inside a Workspace'
                )
            result.append((node, current_path))

        children = node.get("Children", [])
        if children is None:
            return
        if not isinstance(children, list):
            raise ValueError(
                f'Children of "{node.get("Name", node.get("ClassName", "?"))}" must be a list'
            )

        for child in children:
            visit(child, current_path)

    visit(root, None)
    return result


def child_index(children, owner_name):
    by_name = {}

    for child in children:
        if not isinstance(child, dict):
            raise ValueError(f'non-mapping child under "{owner_name}"')

        name = instance_name(child)

        if name in by_name:
            raise ValueError(
                f'duplicate child name "{name}" under StarterCharacter "{owner_name}"'
            )

        by_name[name] = child

    return by_name


def set_properties(node, values):
    p = properties(node)
    p.update(values)


def ensure_named_instance(children, by_name, name, class_name):
    existing = by_name.get(name)

    if existing is not None:
        actual_class = existing.get("ClassName")
        if actual_class != class_name:
            raise ValueError(
                f'"{name}" already exists as {actual_class!r}; expected {class_name!r}'
            )
        return existing

    node = {
        "ClassName": class_name,
        "Name": name,
        "Properties": {},
    }
    children.append(node)
    by_name[name] = node
    return node


def constraint_endpoint_pair(node):
    p = node.get("Properties", {})
    if not isinstance(p, dict):
        return None

    a = reference_leaf(p.get("Cube0"))
    b = reference_leaf(p.get("Cube1"))

    if a is None or b is None:
        return None

    return frozenset((a, b))


def find_legacy_ragdoll(children, ragdoll_name, part0, part1):
    expected_pair = frozenset((part0, part1))
    candidates = []

    for child in children:
        if not isinstance(child, dict):
            continue
        if child.get("ClassName") != "BallSocket":
            continue
        if child.get("Name") == ragdoll_name:
            continue
        if constraint_endpoint_pair(child) == expected_pair:
            candidates.append(child)

    if len(candidates) > 1:
        names = ", ".join(repr(x.get("Name")) for x in candidates)
        raise ValueError(
            f"multiple legacy BallSockets match {part0}<->{part1}: {names}"
        )

    return candidates[0] if candidates else None


def remove_legacy_body_welds(children):
    topology_pairs = {
        frozenset((part0, part1))
        for _, part0, part1 in TOPOLOGY
    }

    kept = []

    for child in children:
        if (
            isinstance(child, dict)
            and child.get("ClassName") == "Weld"
            and constraint_endpoint_pair(child) in topology_pairs
        ):
            continue

        kept.append(child)

    children[:] = kept


def validate_generated_rig(starter, starter_path):
    children = starter.get("Children", [])
    by_name = child_index(children, starter.get("Name", "?"))

    def expected_ref(part):
        return join_ref([*starter_path, part])

    for joint_name, part0, part1 in TOPOLOGY:
        motor = by_name.get(joint_name)
        if motor is None or motor.get("ClassName") != "Motor6D":
            raise ValueError(f"missing generated Motor6D {joint_name}")

        mp = properties(motor)
        if mp.get("Part0") != expected_ref(part0):
            raise ValueError(f"{joint_name}.Part0 was not migrated correctly")
        if mp.get("Part1") != expected_ref(part1):
            raise ValueError(f"{joint_name}.Part1 was not migrated correctly")

        ragdoll_name = joint_name + "Ragdoll"
        ragdoll = by_name.get(ragdoll_name)
        if ragdoll is None or ragdoll.get("ClassName") != "BallSocket":
            raise ValueError(f"missing generated BallSocket {ragdoll_name}")

        rp = properties(ragdoll)
        if rp.get("Cube0") != expected_ref(part0):
            raise ValueError(f"{ragdoll_name}.Cube0 was not migrated correctly")
        if rp.get("Cube1") != expected_ref(part1):
            raise ValueError(f"{ragdoll_name}.Cube1 was not migrated correctly")
        if rp.get("Enabled") is not False:
            raise ValueError(f"{ragdoll_name} must be disabled after migration")

    gyro = by_name.get("RootGyro")
    if gyro is None or gyro.get("ClassName") != "Gyro":
        raise ValueError("missing generated RootGyro")

    if properties(gyro).get("Part") != expected_ref("Root"):
        raise ValueError("RootGyro.Part was not migrated correctly")


def migrate_starter(starter, starter_path):
    children = starter.setdefault("Children", [])
    if not isinstance(children, list):
        raise ValueError(
            f'Children of StarterCharacter "{starter.get("Name", "?")}" must be a list'
        )

    starter_name = instance_name(starter)
    by_name = child_index(children, starter_name)

    missing_parts = sorted(PARTS - set(by_name))
    if missing_parts:
        raise ValueError(
            f'incomplete R6 StarterCharacter "{starter_name}"; '
            f'missing: {", ".join(missing_parts)}'
        )

    frames = {
        name: frame(by_name[name])
        for name in PARTS
    }

    remove_legacy_body_welds(children)
    by_name = child_index(children, starter_name)

    def ref(part):
        return join_ref([*starter_path, part])

    for joint_name, part0, part1 in TOPOLOGY:
        motor = ensure_named_instance(
            children,
            by_name,
            joint_name,
            "Motor6D",
        )

        set_properties(
            motor,
            {
                "Part0": ref(part0),
                "Part1": ref(part1),
                "C0": relative(frames[part0], frames[part1]),
                "C1": identity_cframe(),
                "Transform": identity_cframe(),
                "Frequency": 10.0,
                "DampingRatio": 1.0,
            },
        )

        ragdoll_name = joint_name + "Ragdoll"
        ragdoll = by_name.get(ragdoll_name)

        if ragdoll is not None and ragdoll.get("ClassName") != "BallSocket":
            raise ValueError(
                f'"{ragdoll_name}" already exists as '
                f'{ragdoll.get("ClassName")!r}; expected "BallSocket"'
            )

        if ragdoll is None:
            ragdoll = find_legacy_ragdoll(
                children,
                ragdoll_name,
                part0,
                part1,
            )

            if ragdoll is not None:
                old_name = ragdoll.get("Name", "?")
                ragdoll["Name"] = ragdoll_name
                by_name.pop(old_name, None)
                by_name[ragdoll_name] = ragdoll
            else:
                ragdoll = ensure_named_instance(
                    children,
                    by_name,
                    ragdoll_name,
                    "BallSocket",
                )

        # Always rewrite the endpoints. This makes the migration repair files
        # produced by older buggy versions that wrote ClassName-based paths such
        # as "StarterCharacter\\Root".
        set_properties(
            ragdoll,
            {
                "Cube0": ref(part0),
                "Cube1": ref(part1),
                "Enabled": False,
            },
        )

    gyro = ensure_named_instance(
        children,
        by_name,
        "RootGyro",
        "Gyro",
    )

    set_properties(
        gyro,
        {
            "Part": ref("Root"),
            "TargetRotation": frames["Root"][1],
            "Frequency": 8.0,
            "DampingRatio": 1.0,
            "MaxTorque": 10000.0,
        },
    )

    for part_name in PARTS:
        set_properties(
            by_name[part_name],
            {
                "Anchored": False,
                "CanCollide": part_name == "Root",
                "LockFlags": [],
            },
        )

    validate_generated_rig(starter, starter_path)


def migrate(doc):
    require_mapping(doc, "document")

    root = doc.get("Root")
    if root is None:
        raise ValueError("document has no Root")
    require_mapping(root, "Root")

    before = copy.deepcopy(doc)
    starters = find_starter_characters(root)

    for starter, starter_path in starters:
        migrate_starter(starter, starter_path)

    return doc, doc != before


def iter_files(paths):
    for raw_path in paths:
        path = Path(raw_path)

        if not path.exists():
            raise FileNotFoundError(path)

        if path.is_dir():
            for candidate in sorted(path.rglob("*")):
                if candidate.is_file() and candidate.suffix.lower() in SUPPORTED_SUFFIXES:
                    yield candidate
            continue

        if not path.is_file():
            raise ValueError(f"not a regular file: {path}")

        if path.suffix.lower() not in SUPPORTED_SUFFIXES:
            raise ValueError(f"unsupported file type: {path}")

        yield path


def atomic_write(path, text):
    fd = None
    temp_path = None

    try:
        mode = path.stat().st_mode

        fd, temp_path = tempfile.mkstemp(
            dir=path.parent,
            prefix=path.name + ".",
            suffix=".tmp",
        )

        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            fd = None
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())

        os.chmod(temp_path, mode)
        os.replace(temp_path, path)
        temp_path = None

    finally:
        if fd is not None:
            os.close(fd)

        if temp_path is not None and os.path.exists(temp_path):
            os.unlink(temp_path)


def main():
    parser = argparse.ArgumentParser(
        description="Migrate Recubin StarterCharacter data to Character Rig v2.",
    )
    parser.add_argument(
        "paths",
        nargs="+",
        help="Scene files or directories to scan.",
    )
    parser.add_argument(
        "--write",
        action="store_true",
        help="Write changes. Without this flag the script is dry-run only.",
    )

    args = parser.parse_args()

    pending = []
    errors = 0
    seen = set()

    try:
        candidates = list(iter_files(args.paths))
    except Exception as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1

    for path in candidates:
        key = os.path.normcase(str(path.resolve()))

        if key in seen:
            continue
        seen.add(key)

        try:
            old_text = path.read_text(encoding="utf-8")
            loaded = yaml.safe_load(old_text)

            if loaded is None:
                raise ValueError("empty YAML document")

            document, changed = migrate(loaded)

            if changed:
                new_text = yaml.safe_dump(
                    document,
                    sort_keys=False,
                    allow_unicode=True,
                )
            else:
                new_text = old_text

        except Exception as exc:
            print(f"ERROR {path}: {exc}", file=sys.stderr)
            errors += 1
            continue

        if not changed:
            print(f"unchanged {path}")
            continue

        action = "write" if args.write else "would write"
        print(f"{action} {path}")
        pending.append((path, new_text))

    # Do not partially rewrite a batch if even one input failed migration.
    if args.write and errors:
        print(
            "ABORT: migration errors occurred; no files were written.",
            file=sys.stderr,
        )
        return 1

    if args.write:
        for path, new_text in pending:
            try:
                atomic_write(path, new_text)
            except Exception as exc:
                print(f"ERROR {path}: {exc}", file=sys.stderr)
                errors += 1

    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())