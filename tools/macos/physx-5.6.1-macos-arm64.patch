+// OSXの元々の想定はIntel Macのみ(SSEのFPU制御レジスタを使う)。Apple SiliconにはSSEが
+// 無いため、x86系(PX_ARM/PX_A64ではない)の場合のみこの経路を使う。ARM Macは下のfenv汎用経路にfallbackする。
+#define PX_OSX_INTEL (PX_OSX && !(PX_ARM || PX_A64))
+
+#if PX_OSX_INTEL
 // osx defines SIMD as standard for floating point operations.
